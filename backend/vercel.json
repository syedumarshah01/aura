{
    "version": 2,
    "builds": [
        {
            "src": "server.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/api/:path*",
            "dest": "/api/:path*"
        },
        {
            "src": "/",
            "dest": "/api/server.js"
        }
    ]
}